    {
      "name": "04 Update Booking",
      "item": [
        {
          "name": "TC_API_013 - Update a booking (PUT) with a valid token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString().slice(-6);",
                  "pm.environment.set(\"updatedFirstName\", \"Updated\" + suffix);",
                  "pm.environment.set(\"updatedTotalPrice\", Number(pm.environment.get(\"totalPrice\")) + 100);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test(\"All fields were updated\", function () {",
                  "    pm.expect(b.firstname).to.eql(pm.environment.get(\"updatedFirstName\"));",
                  "    pm.expect(b.lastname).to.eql(pm.environment.get(\"lastName\"));",
                  "    pm.expect(b.totalprice).to.eql(Number(pm.environment.get(\"updatedTotalPrice\")));",
                  "    pm.expect(b.depositpaid).to.eql(false);",
                  "    pm.expect(b.bookingdates.checkin).to.eql(\"2026-12-15\");",
                  "    pm.expect(b.bookingdates.checkout).to.eql(\"2026-12-20\");",
                  "    pm.expect(b.additionalneeds).to.eql(\"Lunch\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "**TC_API_013**: Full update of the booking using the token\n\n**Expected:** All fields updated and returned",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"{{updatedFirstName}}\",\n    \"lastname\": \"{{lastName}}\",\n    \"totalprice\": {{updatedTotalPrice}},\n    \"depositpaid\": false,\n    \"bookingdates\": {\n        \"checkin\": \"2026-12-15\",\n        \"checkout\": \"2026-12-20\"\n    },\n    \"additionalneeds\": \"Lunch\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "TC_API_014 - Reject update without a token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "**TC_API_014**: PUT without authentication\n\n**Expected:** 403 Forbidden, booking not changed",
