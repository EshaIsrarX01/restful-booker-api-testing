    {
      "name": "03 Read Booking",
      "item": [
        {
          "name": "TC_API_009 - Get all booking ids",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Response is a non-empty array\", function () { pm.expect(body).to.be.an(\"array\").and.not.empty; });",
                  "pm.test(\"Every item has a numeric bookingid\", function () {",
                  "    body.forEach(function (item) { pm.expect(item.bookingid).to.be.a(\"number\"); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "**TC_API_009**: Retrieve the list of booking ids\n\n**Expected:** Array of objects, each with a numeric bookingid"
          }
        },
        {
          "name": "TC_API_010 - Get the created booking by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "            pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "            const b = pm.response.json();",
                  "            pm.test(\"Booking data matches what was created\", function () {",
                  "                pm.expect(b.firstname).to.eql(pm.environment.get(\"firstName\"));",
                  "                pm.expect(b.lastname).to.eql(pm.environment.get(\"lastName\"));",
                  "                pm.expect(b.totalprice).to.eql(Number(pm.environment.get(\"totalPrice\")));",
                  "                pm.expect(b.depositpaid).to.eql(true);",
                  "                pm.expect(b.bookingdates.checkin).to.eql(\"2026-12-01\");",
                  "                pm.expect(b.bookingdates.checkout).to.eql(\"2026-12-10\");",
                  "                pm.expect(b.additionalneeds).to.eql(\"Breakfast\");",
                  "            });",
                  "            const bookingSchema = {",
                  "    type: \"object\",",
                  "    required: [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],",
                  "    properties: {",
                  "        firstname: { type: \"string\" },",
                  "        lastname: { type: \"string\" },",
                  "        totalprice: { type: \"number\" },",
                  "        depositpaid: { type: \"boolean\" },",
                  "        bookingdates: {",
                  "            type: \"object\",",
                  "            required: [\"checkin\", \"checkout\"],",
                  "            properties: { checkin: { type: \"string\" }, checkout: { type: \"string\" } }",
                  "        },",
                  "        additionalneeds: { type: \"string\" }",
                  "    }",
                  "};",
                  "            pm.test(\"Response matches the expected schema\", function () { pm.response.to.have.jsonSchema(bookingSchema); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "**TC_API_010**: Retrieve the booking created in TC_API_006\n\n**Expected:** Booking data equals the data that was created; schema valid"
          }
        },
        {
          "name": "TC_API_011 - Filter bookings by first and last name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const ids = pm.response.json().map(function (item) { return item.bookingid; });",
                  "pm.test(\"Filtered result contains the created booking\", function () {",
                  "    pm.expect(ids).to.include(Number(pm.environment.get(\"bookingId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname={{firstName}}&lastname={{lastName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "{{firstName}}"
                },
                {
                  "key": "lastname",
                  "value": "{{lastName}}"
                }
              ]
            },
            "description": "**TC_API_011**: Filter the list with firstname and lastname query parameters\n\n**Expected:** The list contains the booking created in TC_API_006"
          }
        },
