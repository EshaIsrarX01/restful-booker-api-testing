    {
      "name": "02 Create Booking",
      "item": [
        {
          "name": "TC_API_006 - Create a booking with valid data",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique test data on every run, so runs never collide with each other",
                  "const suffix = Date.now().toString().slice(-6) + Math.floor(Math.random() * 100);",
                  "pm.environment.set(\"firstName\", \"Esha\" + suffix);",
                  "pm.environment.set(\"lastName\", \"Tester\" + suffix);",
                  "pm.environment.set(\"totalPrice\", 100 + Math.floor(Math.random() * 900));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "            pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "            pm.test(\"Content-Type is JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "            const body = pm.response.json();",
                  "            pm.test(\"Response contains a numeric bookingid\", function () { pm.expect(body.bookingid).to.be.a(\"number\"); });",
                  "            pm.test(\"Booking data matches the request\", function () {",
                  "                const b = body.booking;",
                  "                pm.expect(b.firstname).to.eql(pm.environment.get(\"firstName\"));",
                  "                pm.expect(b.lastname).to.eql(pm.environment.get(\"lastName\"));",
                  "                pm.expect(b.totalprice).to.eql(Number(pm.environment.get(\"totalPrice\")));",
                  "                pm.expect(b.depositpaid).to.eql(true);",
                  "                pm.expect(b.bookingdates.checkin).to.eql(\"2026-12-01\");",
                  "                pm.expect(b.bookingdates.checkout).to.eql(\"2026-12-10\");",
                  "                pm.expect(b.additionalneeds).to.eql(\"Breakfast\");",
                  "            });",
                  "            const bookingSchema = {",
                  "    type: \"object\",",
                  "    required: [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],",
                  "    properties: {",
                  "        firstname: { type: \"string\" },",
                  "        lastname: { type: \"string\" },",
                  "        totalprice: { type: \"number\" },",
                  "        depositpaid: { type: \"boolean\" },",
                  "        bookingdates: {",
                  "            type: \"object\",",
                  "            required: [\"checkin\", \"checkout\"],",
                  "            properties: { checkin: { type: \"string\" }, checkout: { type: \"string\" } }",
                  "        },",
                  "        additionalneeds: { type: \"string\" }",
                  "    }",
                  "};",
                  "            pm.test(\"Response matches the expected schema\", function () {",
                  "                pm.response.to.have.jsonSchema({",
                  "                    type: \"object\",",
                  "                    required: [\"bookingid\", \"booking\"],",
                  "                    properties: { bookingid: { type: \"number\" }, booking: bookingSchema }",
                  "                });",
                  "            });",
                  "            // Save the id for the read / update / delete requests that follow",
                  "            pm.environment.set(\"bookingId\", body.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "**TC_API_006**: Create a booking and verify the response echoes the data\n\n**Expected:** bookingid returned; booking data matches the request; schema valid",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"{{firstName}}\",\n    \"lastname\": \"{{lastName}}\",\n    \"totalprice\": {{totalPrice}},\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-12-01\",\n        \"checkout\": \"2026-12-10\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "TC_API_007 - Reject a booking without firstname",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 500\", function () { pm.response.to.have.status(500); });",
                  "pm.test(\"No booking was created\", function () { pm.expect(pm.response.text()).to.not.include(\"bookingid\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "**TC_API_007**: A required field (firstname) is missing\n\n**Expected:** Request rejected, no booking created (the API answers 500, see findings)",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"lastname\": \"Tester\",\n    \"totalprice\": 150,\n    \"depositpaid\": true,\n    \"bookingdates\": { \"checkin\": \"2026-12-01\", \"checkout\": \"2026-12-10\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "TC_API_008 - Reject a booking without bookingdates",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 500\", function () { pm.response.to.have.status(500); });",
                  "pm.test(\"No booking was created\", function () { pm.expect(pm.response.text()).to.not.include(\"bookingid\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "**TC_API_008**: A required object (bookingdates) is missing\n\n**Expected:** Request rejected, no booking created",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"Esha\",\n    \"lastname\": \"Tester\",\n    \"totalprice\": 150,\n    \"depositpaid\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
